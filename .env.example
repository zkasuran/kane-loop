# LLM provider (OpenAI-compatible endpoint). Fill these in locally.
# Never commit real values. Copy this file to .env and edit.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai

# Kane CLI auth is handled separately by `kane-cli login`
# (credentials are stored under ~/.testmuai, not here).
